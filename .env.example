# OBDX API environment (copy to `.env` and fill in — never commit `.env`)
#
# Flutter reads these via scripts/run_app.sh or manual --dart-define flags.
# See README.md for run instructions.

APP_ENV=dev

# Required — OBDX API base URL (use HTTPS for UAT/production).
# This must be the OBDX API host (e.g. :7778), NOT the Flutter web static port.
OBDX_BASE_URL=https://your-api-host.example

# Optional — web Dio base URL (required for Chrome CORS). Point at the CORS proxy:
#   set -a && source .env && set +a && node proxy.js
# Local Chrome:
#   OBDX_WEB_FALLBACK_URL=http://localhost:8082
# Shared LAN web build (proxy reachable on the LAN):
#   OBDX_WEB_FALLBACK_URL=http://your-proxy-host:8082
OBDX_WEB_FALLBACK_URL=http://localhost:8082

# Optional — comma-separated session init paths (defaults in AppConfig if empty)
OBDX_INIT_SESSION_PATH=/digx-ui/,/digx-ui,/

# Optional — comma-separated Base64 SHA-256 cert fingerprints (required for UAT/prod HTTPS)
# SSL_PIN_SHA256=sha256/AAAAAAAA...,sha256/BBBBBBBB...
# SSL_PIN_ENABLED=auto

# Optional — OBDX JWT setup touch point for biometric enroll (default APMOBAPP; ask client if corporate differs)
# OBDX_JWT_ACCESS_POINT_ID=APMOBAPP

# Optional — idle session timeout in minutes (default 15, use 0 to disable)
# SESSION_IDLE_TIMEOUT_MINUTES=15

# Optional — device integrity: off | warn | block | auto (default auto)
# DEVICE_SECURITY_MODE=auto
# BLOCK_EMULATOR_IN_RELEASE=true

# Optional — screenshot block on sensitive screens: on | off | auto (default auto)
# SCREEN_PROTECTION_ENABLED=auto

# Optional — default ISD country code for registration phone object (default 91)
# DEFAULT_PHONE_COUNTRY_CODE=91
